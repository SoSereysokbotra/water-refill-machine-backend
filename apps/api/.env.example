NODE_ENV=development
APP_ENV=local
RUN_MODE=all
PORT=3000

# Database (PostgreSQL 16 from infra/docker-compose.yml on port 5434)
DATABASE_URL="postgresql://wrm:wrm_dev_password@localhost:5434/wrm_dev?connection_limit=5"
DIRECT_DATABASE_URL="postgresql://wrm:wrm_dev_password@localhost:5434/wrm_dev"

# Redis (from infra/docker-compose.yml on port 6379)
REDIS_URL="redis://localhost:6379"

# Mosquitto (from infra/docker-compose.yml on port 1883)
MQTT_URL="mqtt://localhost:1883"
MQTT_USERNAME="wrm-backend"
MQTT_PASSWORD="password123"
MQTT_SHARED_GROUP="backend"

# Payment Gateway (ABA PayWay Mock Mode for Phase 1)
PAYWAY_MODE=mock
PAYWAY_BASE_URL="https://checkout-sandbox.payway.com.kh"
PAYWAY_MERCHANT_ID="ec480065"
PAYWAY_API_KEY="mock_api_key"
PAYWAY_CALLBACK_URL="http://localhost:3000/v1/payway/callback"

# Timers & Policies
PAYMENT_TTL_MINUTES=3
PAYMENT_GRACE_SECONDS=60
PAY_REQUEST_MIN_INTERVAL_MS=3000
PAY_REQUEST_BURST=3
CALLBACK_RATE_LIMIT_PER_MIN=600
CLOCK_SKEW_MAX_SECONDS=300
DISPENSE_UNKNOWN_AFTER_SECONDS=300
DISPENSE_ESCALATE_AFTER_HOURS=24
REFUND_MODE=manual
REFUND_CLAIM_MINUTES=30
MACHINE_OFFLINE_AFTER_SECONDS=180

# Retention
RETENTION_OUTBOX_DAYS=7
RETENTION_INBOX_DAYS=7
RETENTION_HEARTBEAT_DAYS=30

AUTH_SECRET="dev_secret_must_change_in_production_32chars"
LOG_LEVEL=info

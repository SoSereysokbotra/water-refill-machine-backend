        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(wrm_dispense_accuracy_diff_percent_bucket[15m])) by (le))",
          "legendFormat": "p50 Sensor Discrepancy",
          "refId": "B"
        }
      ],
      "title": "Dispense Accuracy Difference (|Flow - Weight| / Target %)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },

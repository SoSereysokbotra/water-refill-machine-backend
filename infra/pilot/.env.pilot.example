# Pilot server settings. Copy to .env in this folder (git-ignored) and fill in every <...>.
# Generate secrets on the server with:   openssl rand -hex 32

# --- Server -----------------------------------------------------------------
# Free hostname for HTTPS: your reserved public IP with dashes + .sslip.io
# e.g. IP 152.67.1.23 -> 152-67-1-23.sslip.io
PUBLIC_HOST=<ip-with-dashes>.sslip.io

NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

# --- Database (container on this server; backed up by scripts/backup.sh) -----
POSTGRES_PASSWORD=<openssl rand -hex 32>

# --- MQTT: EMQX Cloud (same broker as the ESP32) -----------------------------
# Only ONE backend may be connected to EMQX: stop your laptop backend (or point it to local Mosquitto).
MQTT_URL=mqtts://d41b5d19.ala.asia-southeast1.emqxsl.com:8883
MQTT_USERNAME=wrm-backend
MQTT_PASSWORD=<EMQX password of wrm-backend>
MQTT_SHARED_GROUP=backend

# --- ABA PayWay --------------------------------------------------------------
# sandbox for the pilot (ABA simulator app); live only with the live merchant account
PAYWAY_MODE=sandbox
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=<merchant id>
PAYWAY_API_KEY=<ABA API key>
# ABA calls this when a payment happens (the backend also polls ABA every 3-5 s)
PAYWAY_CALLBACK_URL=https://<PUBLIC_HOST>/v1/payway/callback

# --- Security ----------------------------------------------------------------
AUTH_SECRET=<openssl rand -hex 32>
SESSION_TTL_DAYS=7
# Needed once to create the first admin user (POST /v1/users with header X-Admin-Key).
# You may remove it afterwards and restart.
ADMIN_API_KEY=<openssl rand -hex 32>
# Optional: only if Prometheus scrapes /metrics
# METRICS_TOKEN=<openssl rand -hex 32>

# --- Alerts (optional) -------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Business timers (defaults from the plan) --------------------------------
PAYMENT_TTL_MINUTES=3
PAYMENT_GRACE_SECONDS=60
REFUND_MODE=manual

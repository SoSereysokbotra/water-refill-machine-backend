# Pilot on a laptop / always-on PC. Copy to .env in this folder (git-ignored) and fill in every <...>.
# Make a secret in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { '{0:x2}' -f $_ })

# --- This PC -----------------------------------------------------------------
# The pilot answers on http://localhost:<port> (only this PC can reach it)
LAPTOP_HTTP_PORT=8080
# Not used on a laptop (Caddy serves plain HTTP); keep the line, the base compose file reads it
PUBLIC_HOST=localhost

NODE_ENV=production
# production = same security as the real server (login required, dev routes hidden)
APP_ENV=production
LOG_LEVEL=info

# --- Database (container on this PC; backed up by laptop.ps1 backup) ---------
POSTGRES_PASSWORD=<secret>

# --- MQTT: EMQX Cloud (same broker as the ESP32) -----------------------------
# Only ONE backend may be connected to EMQX. While the pilot runs, your dev backend AND the test
# suite must use the local Mosquitto: in apps/api/.env set MQTT_URL="mqtt://localhost:1883".
MQTT_URL=mqtts://d41b5d19.ala.asia-southeast1.emqxsl.com:8883
MQTT_USERNAME=wrm-backend
MQTT_PASSWORD=<EMQX password of wrm-backend>
MQTT_SHARED_GROUP=backend

# --- ABA PayWay (sandbox) ----------------------------------------------------
PAYWAY_MODE=sandbox
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=<merchant id>
PAYWAY_API_KEY=<ABA API key>
# ABA cannot reach this PC, so payments are confirmed by polling ABA (every 3-5 s).
# Optional: run "laptop.ps1 tunnel" and put the printed https URL here + /v1/payway/callback
PAYWAY_CALLBACK_URL=http://localhost:8080/v1/payway/callback

# --- Security ----------------------------------------------------------------
AUTH_SECRET=<secret>
SESSION_TTL_DAYS=7
# Needed once to create the first admin user (POST /v1/users with header X-Admin-Key).
ADMIN_API_KEY=<secret>

# --- Alerts (optional) -------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Business timers (defaults from the plan) --------------------------------
PAYMENT_TTL_MINUTES=3
PAYMENT_GRACE_SECONDS=60
REFUND_MODE=manual

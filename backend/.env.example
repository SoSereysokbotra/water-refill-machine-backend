# Copy this file to .env and fill in the values.

# Port the server listens on (0.0.0.0, so the ESP32 on the same Wi-Fi can reach it)
PORT=3000

# Key the machine must send in the X-API-Key header
DEVICE_API_KEY=change-me

# Payment mode:
#   mock    = fake QR + fake payment (no ABA account needed) -> use this to test the LCD
#   sandbox = real ABA PayWay sandbox (needs the credentials below)
#   live    = production (set PAYWAY_BASE_URL to the production host given by ABA)
PAYWAY_MODE=mock

# ABA PayWay credentials (sandbox account: https://sandbox.payway.com.kh/register-sandbox/)
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh

# Optional: public HTTPS URL PayWay should POST to after payment.
# Must be whitelisted by ABA. Leave empty to rely on polling (check-transaction).
PAYWAY_CALLBACK_URL=

# QR lifetime in minutes (PayWay minimum is 3)
QR_LIFETIME_MIN=3

# QR image template name for the PNG returned by PayWay
PAYWAY_QR_TEMPLATE=template3_color

# Prices per volume (placeholders - set your real prices). KHR minimum is 100.
CURRENCY=KHR
PRICE_500=500
PRICE_750=700
PRICE_1000=1000

# MQTT broker (EMQX Cloud). Leave MQTT_URL empty to disable MQTT.
MQTT_URL=mqtts://d41b5d19.ala.asia-southeast1.emqxsl.com:8883
MQTT_USERNAME=wrm-backend
MQTT_PASSWORD=Botra12345!
MQTT_CA_FILE=../certs/emqxsl-ca.crt
